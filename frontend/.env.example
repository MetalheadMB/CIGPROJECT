# Backend API base URL. In dev, leave blank to use the Vite proxy.
# In production (Vercel), set this to your Railway backend URL, e.g.
# VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=

# face-api.js model weights location.
# Defaults to a CDN. To self-host, download the weights into public/models
# and set VITE_FACE_MODELS_URL=/models  (see README).
VITE_FACE_MODELS_URL=https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/model
