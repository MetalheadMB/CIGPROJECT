# ----- Server -----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ----- Database (Neon PostgreSQL) -----
# Get this from your Neon project dashboard. Use the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ----- Auth -----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ----- Storage -----
# "local" (default, files served from /uploads) or "s3"
STORAGE_DRIVER=local
# Public base URL of the backend (used to build media URLs for the local driver)
PUBLIC_URL=http://localhost:5000

# ----- AWS S3 (only needed if STORAGE_DRIVER=s3) -----
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ----- AI -----
# "local" (face matching done in-app from client descriptors) or "rekognition"
AI_DRIVER=local
# Max euclidean distance for a face to be considered a match (lower = stricter)
FACE_MATCH_THRESHOLD=0.55
